<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.hms.controllers.AdminDashboardController"
            styleClass="main-container">

    <!-- TOP BAR -->
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="16">
            <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                <image><Image url="@../images/hms_logo.png"/></image>
            </ImageView>
            <Label text="Hospital Management System" styleClass="top-bar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="loggedInLabel" styleClass="top-bar-user"/>
            <Button text="Logout" styleClass="logout-button" onAction="#handleLogout"/>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox styleClass="sidebar" spacing="4" minWidth="220">
            <Label text="ADMIN PANEL" styleClass="sidebar-section-label"/>

            <Button text="📊  Dashboard"     styleClass="sidebar-button" maxWidth="Infinity" onAction="#showDashboard"/>
            <Button text="👥  Users"          styleClass="sidebar-button" maxWidth="Infinity" onAction="#showUsers"/>
            <Button text="🛏  Beds"           styleClass="sidebar-button" maxWidth="Infinity" onAction="#showBeds"/>
            <Button text="🏥  Theatres"       styleClass="sidebar-button" maxWidth="Infinity" onAction="#showTheatres"/>
            <Button text="📅  Schedules"      styleClass="sidebar-button" maxWidth="Infinity" onAction="#showSchedules"/>
            <Button text="📦  Allocations"    styleClass="sidebar-button" maxWidth="Infinity" onAction="#showAllocations"/>
            <Button text="📈  Reports"        styleClass="sidebar-button" maxWidth="Infinity" onAction="#showReports"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator/>
            <Label fx:id="userInfoLabel" styleClass="sidebar-user-info" wrapText="true"/>
            <padding><Insets top="16" bottom="16" left="12" right="12"/></padding>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <!-- Content loads here dynamically -->
        </StackPane>
    </center>

</BorderPane>